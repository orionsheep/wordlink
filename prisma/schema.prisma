generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["LPT_english"]
}

model QuizRecord {
  id          String   @id
  userId      String
  word        String
  testType    Int
  score       Int
  isCorrect   Boolean? @default(true)
  userInput   String?
  timeSpentMs Int?
  timestamp   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([word])
  @@index([userId, timestamp])
  @@schema("LPT_english")
}

model StudyPlan {
  id        String   @id
  userId    String   @unique
  dailyGoal Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("LPT_english")
}

model User {
  id                String              @id
  email             String              @unique
  nickname          String?
  avatar            String?
  role              String              @default("user")
  preferredLanguage String              @default("zh")
  dailyGoal         Int                 @default(50)
  streakDays        Int                 @default(0)
  lastActiveAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  CheckinLog        CheckinLog[]
  QuizRecord        QuizRecord[]
  StudyPlan         StudyPlan?
  UserLibrary       UserLibrary[]
  UserWordState     UserWordState[]
  WordVisit         WordVisit[]
  chat_sessions     chat_sessions[]
  note_interactions note_interactions[]
  word_notes        word_notes[]

  @@schema("LPT_english")
}

model UserLibrary {
  id              String            @id
  userId          String
  name            String
  description     String?
  type            String            @default("USER")
  isPublic        Boolean           @default(false)
  wordCount       Int               @default(0)
  starCount       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserLibraryWord UserLibraryWord[]

  @@index([userId])
  @@schema("LPT_english")
}

model UserLibraryWord {
  id          String      @id
  libraryId   String
  word        String
  sequence    Int
  createdAt   DateTime    @default(now())
  UserLibrary UserLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([libraryId, sequence])
  @@index([libraryId])
  @@index([word])
  @@schema("LPT_english")
}

model WordVisit {
  id          String   @id
  userId      String
  word        String
  source      String?
  dwellTimeMs Int?     @default(0)
  audioPlays  Int?     @default(0)
  timestamp   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([word])
  @@index([userId, timestamp])
  @@schema("LPT_english")
}

model chat_messages {
  id            String        @id
  sessionId     String
  role          String
  content       String
  tokensUsed    Int?
  createdAt     DateTime      @default(now())
  chat_sessions chat_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@schema("LPT_english")
}

model chat_sessions {
  id            String          @id
  userId        String
  title         String          @default("新对话")
  category      Int             @default(3)
  word          String?
  wordGroup     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now())
  chat_messages chat_messages[]
  User          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([userId])
  @@schema("LPT_english")
}

model note_interactions {
  id         String     @id
  userId     String
  noteId     String
  type       String
  content    String?
  createdAt  DateTime   @default(now())
  word_notes word_notes @relation(fields: [noteId], references: [id], onDelete: Cascade)
  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId, type])
  @@index([noteId])
  @@index([userId, type])
  @@schema("LPT_english")
}

model word_notes {
  id                String              @id
  userId            String
  word              String
  content           String
  isPublic          Boolean             @default(true)
  likeCount         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  note_interactions note_interactions[]
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@index([word])
  @@schema("LPT_english")
}

model CheckinLog {
  id          String   @id
  userId      String
  date        DateTime @db.Date
  wordsCount  Int      @default(0)
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@schema("LPT_english")
}

model UserWordState {
  id               String    @id
  userId           String
  word             String
  stage            String    @default("UNFAMILIAR")
  memoryStrength   Float     @default(0.0)
  stability        Float     @default(1.0)
  repetitionCount  Int       @default(0)
  consecutiveRight Int       @default(0)
  wrongCount       Int       @default(0)
  lastTestedAt     DateTime?
  nextReviewAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, nextReviewAt])
  @@index([userId, stage])
  @@index([word])
  @@schema("LPT_english")
}

model word_chinese {
  id                String   @id
  wordId            String   @unique
  word              String   @unique
  pronunciation     String   @default("")
  conciseDefinition String
  forms             Json     @default("{}")
  definitions       Json     @default("[]")
  comparison        Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  words             words    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([word])
  @@schema("LPT_english")
}

model word_ecdict {
  id          String   @id
  wordId      String   @unique
  word        String   @unique
  phonetic    String   @default("")
  translation String
  collins     String   @default("")
  tag         String   @default("")
  exchange    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  words       words    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([word])
  @@schema("LPT_english")
}

model word_fission {
  id             String   @id
  wordId         String
  word           String
  partOfSpeech   String
  meaningNumber  String
  definitionText String
  synonym        String
  createdAt      DateTime @default(now())
  words          words    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([synonym])
  @@index([word])
  @@schema("LPT_english")
}

model word_markdown {
  id        String   @id
  wordId    String   @unique
  word      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  words     words    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([word])
  @@schema("LPT_english")
}

model words {
  id            String         @id
  word          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  word_chinese  word_chinese?
  word_ecdict   word_ecdict?
  word_fission  word_fission[]
  word_markdown word_markdown?

  @@index([word])
  @@schema("LPT_english")
}

// ===== Ambient 沉浸式阅读（方案 B：本地文章库，支持 AI 生成）=====
model AmbientArticle {
  id        String   @id @default(uuid())
  title     String
  titleZh   String?
  level     String   @default("B1") // A2 / B1 / B2 / C1
  season    String? // 绑定季节场景: spring / summer / autumn / winter
  source    String   @default("ai") // ai = DeepSeek 生成, curated = 精选人工, import = EchoStream 同步
  paragraphs Json // [{ en, zh?, audioUrl? }]
  wordCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([level])
  @@schema("LPT_english")
}
