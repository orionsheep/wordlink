# 统一行尾：仓库内一律 LF，杜绝跨平台 CRLF 漂移造成的万文件级 diff 噪音
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.db binary
*.sqlite binary
*.safetensors binary
*.bin binary
*.csv -text
