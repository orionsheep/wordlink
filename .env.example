# =============================================================================
# WordLink Environment Variables Template
# Copy this file to `.env` or `.env.local` and fill in your real values.
# NEVER commit real secrets to Git.
# =============================================================================

# --- Database (PostgreSQL / Prisma) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=english_word_fission_dev
DATABASE_URL="postgresql://postgres:change-me-strong-password@127.0.0.1:5432/english_word_fission_dev?schema=LPT_english"

# --- App & Demo Mode ---
# Set to "true" only for local/isolated demo environments without Supabase Auth
DEMO_MODE=false
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- LLM Gateway (SiliconFlow / DeepSeek) ---
LLM_BASE_URL="https://api.siliconflow.cn/v1"
LLM_MODEL="deepseek-ai/DeepSeek-V3.2"
LLM_MODEL_FAST="deepseek-ai/DeepSeek-V3.2"
LLM_MODEL_REASONER="deepseek-ai/DeepSeek-R1"
SILICONFLOW_APIKEY="your-siliconflow-api-key"

# --- Free Tier Daily Quotas ---
AI_CHAT_FREE_DAILY_LIMIT=20
AMBIENT_FREE_DAILY_LIMIT=3
PASSPORT_FREE_DAILY_LIMIT=3

# --- Alipay (Web Payment) ---
ALIPAY_APP_ID="your-alipay-app-id"
ALIPAY_PRIVATE_KEY="your-alipay-rsa2-private-key"
ALIPAY_PUBLIC_KEY="your-alipay-rsa2-public-key"
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_NOTIFY_URL="https://your-domain.com/api/pay/notify"
ALIPAY_RETURN_URL="https://your-domain.com/pay/return"
ALIPAY_SELLER_ID="your-alipay-seller-id"

# --- Optional Internal Services (EchoStream FastAPI) ---
FASTAPI_INTERNAL_URL="http://127.0.0.1:8000"
